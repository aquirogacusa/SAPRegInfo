MAPBOX_ACCESS_TOKEN=tu_token_aqui

# Solo para maquinas detras de un proxy de inspeccion SSL (ej. Netskope)
# que bloquea la verificacion del certificado. Usa "1" como ultimo recurso
# mientras IT corrige el certificado del proxy. Deja vacio en desarrollo.
# MAPBOX_SSL_ALLOW_INSECURE=1

# Nombre con el que se MUESTRA el remitente (no cambia la direccion real;
# es el alias de visualizacion estandar del correo, sin suplantacion).
MAIL_FROM_NAME=SAP RegInfo - Notificaciones

# --- Notificaciones: modo RESEND (API, opcion gratuita sin IP whitelisting) ---
# 1) Cuenta gratuita en resend.com (con el correo donde QUIERES recibir avisos)
# 2) Dashboard -> API Keys -> Create API Key (empieza con "re_")
# 3) Sin dominio verificado, Resend solo entrega a la PROPIA cuenta de registro:
#    pon ese correo en EMAIL_RECIPIENTS y deja RESEND_FROM como resend.dev
# RESEND_API_KEY=re_xxxxxxxxxxxx
# RESEND_FROM=onboarding@resend.dev
# (Cuando verifiques un dominio: RESEND_FROM=SAPRegInfo <notificaciones@tudominio>)

# --- Notificaciones: modo BREVO (gratuito, 300 correos/dia, con adjunto) ---
# 1) Cuenta gratuita en brevo.com
# 2) Verifica el REMITENTE: perfil -> Senders, Domains & Dedicated IPs -> Senders
#    -> Add sender (tu correo corporativo) -> confirma el correo que llega
# 3) Genera la API key: perfil -> SMTP & API -> API Keys -> Generate new key (v3)
# BREVO_API_KEY=xkeysib-xxxxxxxxxxxx
# BREVO_FROM=scan@cordialsausa.com   (debe ser el remitente YA verificado en Brevo)
# EMAIL_RECIPIENTS=persona1@domino.com,persona2@domino.com

# --- Notificaciones: modo RELAY corporativo (Microsoft, sin credenciales) ---
# La autorizacion es por IP publica (pedir a IT por cada maquina).
SMTP_SERVER=cordialsausa-com.mail.protection.outlook.com
SMTP_PORT=25
SENDER_EMAIL=scan@cordialsausa.com
EMAIL_RECIPIENTS=it@cordialsausa.com

# --- Notificaciones: modo con login (ej. Gmail, por si se necesitara) ---
# Deja SENDER_PASSWORD vacio en relay; usalo solo si el servidor exige login:
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SENDER_PASSWORD=tu_password_de_aplicacion
# Escape para relays que exigen STARTTLS sin credenciales:
# SMTP_USE_TLS=1
